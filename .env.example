# Local development secrets for `dotnet run`. Copy to `.env` and fill in values:
#   copy .env.example .env
# `.env` is gitignored and loaded automatically by the API at startup;
# this file is safe to commit because it contains only placeholders.
# Real environment variables always win over `.env` values.

# Orchestrator database (also used by `dotnet run`).
ORCHESTRATOR_CONNECTION_STRING=Host=localhost;Database=orchestrator;Username=orchestrator;Password=orchestrator

# Used only by `dotnet ef` commands (DesignTimeDbContextFactory).
ORCHESTRATOR_DESIGNTIME_CONNECTION=Host=localhost;Database=orchestrator;Username=orchestrator;Password=orchestrator

# Slack: signing secret verifies inbound webhooks, bot token posts messages.
ORCHESTRATOR_SECRET_SLACK_SIGNING_SECRET=
ORCHESTRATOR_SECRET_SLACK_BOT_TOKEN=

# Azure DevOps: PAT for Git/PR operations, webhook password for service hooks.
ORCHESTRATOR_SECRET_AZUREDEVOPS_PAT=
ORCHESTRATOR_SECRET_AZUREDEVOPS_WEBHOOK_PASSWORD=

# Coding agents (passed into the sandbox container per invocation).
ORCHESTRATOR_SECRET_ANTHROPIC_API_KEY=
ORCHESTRATOR_SECRET_OPENAI_API_KEY=

# P1 named-query connections. The admin page defaults to p1.default.connection;
# point it at p1.staging.connection (or another key) per environment instead.
ORCHESTRATOR_SECRET_P1_DEFAULT_CONNECTION=
ORCHESTRATOR_SECRET_P1_STAGING_CONNECTION=
