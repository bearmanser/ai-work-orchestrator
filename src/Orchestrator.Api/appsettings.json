{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AgentProviders": {
    "claude": {
      "Image": "orchestrator/worker:latest",
      "Command": ["claude"],
      "Arguments": ["-p", "--output-format", "json", "--permission-mode", "acceptEdits"],
      "PromptVia": "Stdin",
      "ApiKeySecretRef": "anthropic.api-key",
      "ApiKeyEnvironmentVariable": "ANTHROPIC_API_KEY",
      "Model": "claude-opus-5"
    }
  }
}
