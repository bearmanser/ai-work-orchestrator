<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- See tests/Orchestrator.Integration.Tests/Orchestrator.Integration.Tests.csproj for why these
         audit warnings are suppressed: WireMock.Net 1.6.7 pulls transitive packages below their
         patched versions with no patched WireMock release available. -->
    <NoWarn>$(NoWarn);NU1902;NU1903;NU1904</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="LibGit2Sharp" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="WireMock.Net" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="SSH.NET">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Orchestrator.Domain\Orchestrator.Domain.csproj" />
    <ProjectReference Include="..\..\src\Orchestrator.Application\Orchestrator.Application.csproj" />
    <ProjectReference Include="..\..\src\Orchestrator.Infrastructure\Orchestrator.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\Orchestrator.Api\Orchestrator.Api.csproj" />
    <ProjectReference Include="..\..\src\Orchestrator.Adapters.Agent\Orchestrator.Adapters.Agent.csproj" />
    <ProjectReference Include="..\..\src\Orchestrator.Adapters.Git\Orchestrator.Adapters.Git.csproj" />
    <ProjectReference Include="..\..\src\Orchestrator.Adapters.AzureDevOps\Orchestrator.Adapters.AzureDevOps.csproj" />
    <ProjectReference Include="..\..\src\Orchestrator.Adapters.Slack\Orchestrator.Adapters.Slack.csproj" />
    <!-- Reuses ManualTimeProvider and PostgresFixture rather than duplicating them
         (see ManualTimeProvider.cs's doc comment). -->
    <ProjectReference Include="..\Orchestrator.Integration.Tests\Orchestrator.Integration.Tests.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\fixtures\agent-replays\*.json" Link="fixtures\agent-replays\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
